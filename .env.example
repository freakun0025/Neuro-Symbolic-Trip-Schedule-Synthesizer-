# Copy to .env (never commit .env). One OpenAI-compatible endpoint; switch provider by changing the base URL.

OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1                              # Groq
# OPENAI_BASE_URL=https://openrouter.ai/api/v1                                # OpenRouter
# OPENAI_BASE_URL=http://localhost:11434/v1                                   # local Ollama
OPENAI_API_KEY=

# Default model for every role. Check the provider's current model ids; never hard-code them in source.
NSTRIP_MODEL=

# Optional per-role overrides: EXTRACT, BASELINE, CODEGEN, PARAPHRASE, REPHRASE
# NSTRIP_BASELINE_MODEL=
# NSTRIP_BASELINE_BASE_URL=      # run one role on a different provider
# NSTRIP_BASELINE_API_KEY=

# live = call the API (responses are cached); cache = replay data/cache/llm only, never touch the network
NSTRIP_MODE=live
